  "result": "PASS_NATIVE_AND_SCOPED_STOCK_CLIENT_REGRESSION",
  "scope": "Exact Forge VanillaDoubleChestItemHandler and exact plain InvWrapper classes; original handlers retain all transfers. No inferred mapping of opaque subclasses, CombinedInvWrapper or SidedInvWrapper.",
  "contract": {
    "physical_slots": "Native double chest uses getChest(slot<27) plus slot%27; exact InvWrapper uses getInv() plus native slot. Equality uses backing object identity and physical slot, never display contents or provider equality.",
    "overlap": "Deduplicate each occupied physical slot, preserving first logical source and disjoint remaining halves; raw slot scans, including duplicates, still consume the existing 4096 work bound.",
    "quarantine": "Known backing inventories join the existing same-network loaded endpoint uncertainty fence before ready-route selection.",
    "stale_backing": "Known physical identity is retained in snapshots, compared when refreshing rows and rechecked before extraction, so identical contents on a replacement backing inventory cannot authorize an old click.",
    "opaque_lifecycle": "Opaque adapters keep their existing logical node/slot identity so fresh wrappers do not disable established routes. Their hidden backing identity remains unqualified.",
    "bounds": "No reflection or raw backing-inventory transfer bypass; original sided/provider handlers, full-NBT variant checks, shared transfer work, persistent escrow and nonwrapping revisions remain."
  },
